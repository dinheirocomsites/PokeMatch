{
  "name": "pokematch",
  "version": "0.1.0",
  "description": "Sugere tech cards para o seu deck de Pokémon TCG contra um deck específico",
  "type": "module",
  "scripts": {
    "sync": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/sync-cards.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build-static.js",
    "audit": "node scripts/audit-damage.js",
    "build:single": "node scripts/build-single.js",
    "audit:coverage": "node scripts/audit-coverage.js",
    "classify": "node scripts/llm-classify.js",
    "classify:dry": "node scripts/llm-classify.js --dry-run",
    "build:lovable": "node scripts/build-lovable.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "esbuild": "^0.24.2"
  }
}
